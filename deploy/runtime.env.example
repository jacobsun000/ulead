# Preparation template, not a production-ready deployment.
# Copy to a git-ignored *.env file; never put production values in this file.
# China: cn / postgres / true. US: us / neon / false.
SITE_REGION=cn
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://ulead:REPLACE_WITH_PASSWORD@database:5432/ulead
ADMIN_ENABLED=true
ADMIN_HOST=admin.ulead-edu.com
ADMIN_USERNAME=REPLACE_WITH_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# US Neon deployment uses POSTGRES_URL (DATABASE_URL is the fallback).
# Do not copy the China DATABASE_URL to Vercel.
# Uploads currently still use Vercel Blob. COS support is a cutover prerequisite.
# BLOB_READ_WRITE_TOKEN=
